NODE_ENV=development
POSTGRES_USER=devhub
POSTGRES_PASSWORD=devhub
POSTGRES_DB=devhub
DATABASE_URL=postgresql://devhub:devhub@postgres:5432/devhub?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=3h
JWT_REFRESH_TTL=30d
API_PORT=4000
API_MODULE=all
WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://api-gateway:4000/api
WEB_APP_URL=
ALLOWED_DEV_ORIGINS=
APP_SETTINGS_PATH=storage/config/app-settings.json
ATTACHMENT_STORAGE_PROVIDER=local
ATTACHMENT_LOCAL_BASE_PATH=C:\DatosApp
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_PATH=DevOpsHub/Attachments
MICROSOFT_AUTH_ENABLED=false
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://tu-dominio-o-ip/api/auth/microsoft/callback
MICROSOFT_SCOPES=openid profile email offline_access User.Read Sites.ReadWrite.All
MICROSOFT_ALLOWED_DOMAINS=
MICROSOFT_DEFAULT_ORG_NAME=Microsoft Workspace
MICROSOFT_DEFAULT_ORG_SLUG=microsoft-workspace
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tu-dominio-o-ip/api/auth/google/callback
GOOGLE_SCOPES=openid profile email
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_DEFAULT_ORG_NAME=Google Workspace
GOOGLE_DEFAULT_ORG_SLUG=google-workspace
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_INTEGRATION_ENABLED=false
GITHUB_AUTH_MODE=token
GITHUB_DEFAULT_OWNER=
GITHUB_TOKEN_ENV_VAR=GITHUB_TOKEN
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_ENV_VAR=GITHUB_PRIVATE_KEY
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET_ENV_VAR=GITHUB_WEBHOOK_SECRET
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@devhub.local
